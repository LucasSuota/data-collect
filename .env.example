# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.

# Caminho do arquivo SQLite
FORMS_DB_PATH=forms.db

# Origens do frontend permitidas no CORS, separadas por vírgula (nunca "*")
FORMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Só necessário para os módulos opcionais de IA
ANTHROPIC_API_KEY=
