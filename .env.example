# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.

# Caminho do arquivo SQLite
FORMS_DB_PATH=forms.db

# Pasta dos dados do usuário (fotos em anexos/). Padrão: a pasta do banco
# FORMS_DATA_DIR=

# Token exigido no cabeçalho X-Forms-Token. No app instalado o Electron o gera a cada
# execução. Sem token configurado (e sem a dispensa abaixo), a API recusa toda requisição.
FORMS_TOKEN=

# Só em desenvolvimento (navegador + Vite): dispensa o token. Nunca use no app instalado.
FORMS_SKIP_TOKEN=1

# Origens do frontend permitidas no CORS, separadas por vírgula (nunca "*")
FORMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Só necessário para os módulos opcionais de IA (instale o SDK com `uv sync --extra ia`)
ANTHROPIC_API_KEY=
# Modelo usado pelo LLM (padrão: claude-sonnet-5-5)
# FORMS_LLM_MODELO=
# Pasta dos procedimentos .md do assistente (padrão: docs/ do repositório)
# FORMS_DOCS_DIR=
