# Copie para `.env` e preencha. O `.env` NUNCA vai para o git (AGENTS.md §3.3, §12).

# --- Banco ---
POSTGRES_USER=forms
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=forms
# Senha do papel `forms_app` (o que a API usa; sem BYPASSRLS, então o isolamento por equipe vale)
FORMS_APP_PASSWORD=troque-esta-senha-tambem
# Só em desenvolvimento: porta do Postgres no localhost
POSTGRES_PORTA=5433

# --- Endereços (sem http://). Em desenvolvimento, `localhost` e `auth.localhost` funcionam
# sozinhos (o Caddy usa um certificado interno). Em produção, dois nomes do seu domínio.
APP_HOST=localhost
AUTH_HOST=auth.localhost
AUTH_ADMIN_HOST=auth-admin.localhost
ACME_EMAIL=
HTTP_PORTA=80
HTTPS_PORTA=443

# --- Primeiro administrador: na primeira subida (instalação vazia) a API cria a equipe e escreve
# no log o link do convite desta pessoa (`docker compose logs api | grep convite`).
FORMS_ADMIN_EMAIL=
FORMS_EQUIPE_INICIAL=Minha equipe

# --- E-mail (verificação de conta e recuperação de senha). Em desenvolvimento vai para o Mailpit
# (http://localhost:8025). Em produção aponte para o seu SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@data-collect.local
SMTP_SEGURO=false

# --- IA (opcional). A chave-mestra cifra a chave de IA de cada equipe no banco:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde-a FORA do backup do banco; com ela perdida, as chaves cadastradas ficam ilegíveis.
FORMS_CHAVE_MESTRA=
# Padrão da instância para equipes que ligam a IA sem configurar o próprio provedor
ANTHROPIC_API_KEY=

# --- Backup ---
BACKUP_RETENCAO_DIAS=14
