# Proxy reverso do data-collect (AGENTS.md §4.1, §12): HTTPS automático, limite de taxa e conexões,
# cabeçalhos de segurança, front estático e login (Logto) em hosts separados.
{
	# Em produção defina ACME_EMAIL (aviso de expiração do Let's Encrypt). Em `localhost` o Caddy
	# usa a CA interna e o e-mail não é usado.
	email {$ACME_EMAIL:admin@exemplo.invalid}
	# Limites de taxa por IP (módulo caddy-ratelimit). É a camada global; a API limita por pessoa.
	order rate_limit before basicauth
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
		max_header_size 16KB
	}
}

(cabecalhos) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
}

{$APP_HOST:localhost} {
	import cabecalhos
	encode zstd gzip

	# A API (corpo máximo de 1 MB; a aplicação também confere, §12)
	handle /api/* {
		rate_limit {
			zone api_por_ip {
				key {remote_host}
				events 600
				window 1m
			}
		}
		request_body {
			max_size 1MB
		}
		uri strip_prefix /api
		reverse_proxy api:8000 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Configuração em tempo de execução do front (escrita pelo `logto-setup`; fora de /config, que o Caddy usa para o próprio estado)
	handle /config.json {
		header Cache-Control "no-store"
		root * /etc/data-collect
		rewrite * /frontend-config.json
		file_server
	}

	# O front: arquivos com hash em cache longo, `index.html` sempre revalidado (SPA).
	# A CSP fica só aqui: a API já manda a dela (`default-src 'none'`).
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://{$AUTH_HOST:auth.localhost}; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; manifest-src 'self'; worker-src 'self'"
		root * /srv
		@estaticos path /assets/*
		header @estaticos Cache-Control "public, max-age=31536000, immutable"
		@index not path /assets/*
		header @index Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Login e cadastro (Logto): limite bem mais estrito contra força bruta e enumeração
{$AUTH_HOST:auth.localhost} {
	import cabecalhos
	encode zstd gzip
	rate_limit {
		zone auth_por_ip {
			key {remote_host}
			events 60
			window 1m
		}
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy logto:3001 {
		header_up X-Forwarded-Proto {scheme}
	}
}
